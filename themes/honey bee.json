  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#B0A078", "fontStyle": "italic" }
    },
    {
      "scope": ["variable", "string constant.other.placeholder", "meta.object-literal.key", "support.variable"],
      "settings": { "foreground": "#3D2C07" }
    },
    {
      "scope": ["variable.other.readwrite", "variable.other.object", "variable.other.property"],
      "settings": { "foreground": "#6B4A12" }
    },
    {
      "scope": ["variable.parameter", "variable.parameter.function.language.special"],
      "settings": { "foreground": "#B5586B", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#B87A00", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword.control", "keyword.control.conditional", "keyword.control.import", "keyword.control.from"],
      "settings": { "foreground": "#A8650A", "fontStyle": "bold" }
    },
    {
      "scope": ["keyword.operator", "keyword.control.operator"],
      "settings": { "foreground": "#8A7448" }
    },
    {
      "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "punctuation.definition.tag", "punctuation.definition.parameters", "punctuation.definition.block"],
      "settings": { "foreground": "#A89464" }
    },
    {
      "scope": ["string", "string.quoted", "markup.inline.raw.string.markdown", "markup.fenced_code.block.markdown"],
      "settings": { "foreground": "#6F9A5A" }
    },
    {
      "scope": ["punctuation.definition.string.begin", "punctuation.definition.string.end"],
      "settings": { "foreground": "#8FB37A" }
    },
    {
      "scope": ["string.regexp", "constant.character.escape", "constant.escape"],
      "settings": { "foreground": "#5E9C9A" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "keyword.other.unit", "support.constant"],
      "settings": { "foreground": "#D0743C" }
    },
    {
      "scope": ["entity.name.function", "variable.function", "support.function", "meta.function-call entity.name.function", "entity.name.method", "meta.class-method entity.name.function"],
      "settings": { "foreground": "#9C6B1E", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "support.type.sys-types"],
      "settings": { "foreground": "#5B8FA8" }
    },
    {
      "scope": ["entity.name.namespace", "entity.name.module", "support.other.namespace", "meta.use"],
      "settings": { "foreground": "#5B8FA8" }
    },
    {
      "scope": ["entity.name.tag", "meta.tag.sgml"],
      "settings": { "foreground": "#A8650A", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.html"],
      "settings": { "foreground": "#9C6B1E", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.other.attribute-name.id", "entity.other.attribute-name.class", "entity.other.attribute-name.pseudo-class"],
      "settings": { "foreground": "#B87A00" }
    },
    {
      "scope": [
        "source.css support.type.property-name",
        "source.sass support.type.property-name",
        "source.scss support.type.property-name",
        "source.less support.type.property-name",
        "source.stylus support.type.property-name",
        "source.postcss support.type.property-name"
      ],
      "settings": { "foreground": "#6B4A12" }
    },
    {
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#9C6B1E" }
    },
    {
      "scope": ["constant.other.symbol", "constant.other.key", "constant.other.object.key", "string.unquoted.label"],
      "settings": { "foreground": "#9C6B1E" }
    },
    {
      "scope": ["constant.other.color"],
      "settings": { "foreground": "#D0743C" }
    },
    {
      "scope": ["variable.other.constant"],
      "settings": { "foreground": "#D0743C" }
    },
    {
      "scope": ["tag.decorator", "meta.decorator", "entity.name.function.decorator"],
      "settings": { "foreground": "#A56B93", "fontStyle": "italic" }
    },
    {
      "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
      "settings": { "foreground": "#C85A54" }
    },
    {
      "scope": ["markup.heading", "markdown.heading", "markup.heading entity.name", "markup.heading.markdown punctuation.definition.heading.markdown", "entity.name.section.markdown"],
      "settings": { "foreground": "#A8650A", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold", "markup.bold.markdown"],
      "settings": { "foreground": "#3D2C07", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic", "markup.italic.markdown"],
      "settings": { "foreground": "#3D2C07", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.underline", "markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#B87A00", "fontStyle": "underline" }
    },
    {
      "scope": ["string.other.link.title.markdown", "string.other.link.description.title.markdown", "constant.other.reference.link.markdown"],
      "settings": { "foreground": "#9C6B1E" }
    },
    {
      "scope": ["markup.inline.raw", "markup.raw.block", "text.html.markdown markup.inline.raw.markdown"],
      "settings": { "foreground": "#6F9A5A" }
    },
    {
      "scope": ["punctuation.definition.raw.markdown", "punctuation.definition.markdown", "markup.quote punctuation.definition.blockquote.markdown", "punctuation.definition.list_item.markdown"],
      "settings": { "foreground": "#C9B98A" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "#7A6535", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.strike"],
      "settings": { "fontStyle": "strikethrough" }
    },
    {
      "scope": ["meta.separator"],
      "settings": { "foreground": "#C9B98A", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#6F9A5A" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#C85A54" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#B87A00" }
    },
    {
      "scope": "token.info-token",
      "settings": { "foreground": "#5B8FA8" }
    },
    {
      "scope": "token.warn-token",
      "settings": { "foreground": "#C9962A" }
    },
    {
      "scope": "token.error-token",
      "settings": { "foreground": "#C85A54" }
    },
    {
      "scope": "token.debug-token",
      "settings": { "foreground": "#A56B93" }
    }
  ]
}